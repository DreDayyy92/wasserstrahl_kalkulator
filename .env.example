# Kopie dieser Datei nach ".env" anlegen und mit echten Werten fuellen.
# ".env" selbst ist in .gitignore und landet NIE auf GitHub.

# SMTP-Zugangsdaten des Postfachs, ueber das Auftrags-Mails verschickt werden
# (z.B. bei IONOS, Strato, All-Inkl - Angaben stehen im Kundenportal des
# jeweiligen Hosters unter "SMTP" bzw. "Postausgangsserver").
SMTP_HOST=smtp.beispiel-provider.de
SMTP_PORT=587
SMTP_USERNAME=schneiden@baeckereitechnik-doerner.de
SMTP_PASSWORD=hier-echtes-passwort-eintragen

# Absender- und Zieladresse fuer eingehende Auftraege
MAIL_FROM=schneiden@baeckereitechnik-doerner.de
MAIL_TO=schneiden@baeckereitechnik-doerner.de
